# Copy this file to .env and fill in the values.
# Generate a secret key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=True
# Comma-separated, without spaces
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Show the demo account (run "python manage.py seed_demo_data") on the login page
TASKMAKAR_DEMO_MODE=True
# Optional: a persistent database instead of SQLite, e.g. PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/taskmakar
